# Where filtered messages get written. Point this at a folder Syncthing
# is already watching (e.g. inside your Obsidian vault).
VAULT_PATH=/data/vault

# Where Baileys session credentials + the SQLite DB are stored.
# Keep this on a persistent volume so you don't have to re-scan the QR
# every restart.
STATE_PATH=/data/state

# Dashboard
DASHBOARD_PORT=8080
DASHBOARD_USER=admin
DASHBOARD_PASS=change-me-please

# Filtering defaults (can also be changed later from the dashboard)
MIN_TEXT_LENGTH=3
MAX_MEDIA_MB=15
DEDUP_TTL_HOURS=72
